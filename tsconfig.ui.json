{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "@testing-library/jest-dom/vitest"],
    "tsBuildInfoFile": "./node_modules/.cache/tsc/ui.tsbuildinfo"
  },
  "include": [
    "src/ui/**/*.ts",
    "src/ui/**/*.tsx",
    "src/shared/**/*.ts",
    "vitest-env.d.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.server.json"
    }
  ]
}
